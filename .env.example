# Nguồn dữ liệu: mock | api
VITE_DATA_SOURCE=mock

# Địa chỉ gốc của Django API khi chuyển sang chế độ api (không chứa secret)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Tên cookie CSRF mặc định của Django
VITE_CSRF_COOKIE_NAME=csrftoken
VITE_CSRF_HEADER_NAME=X-CSRFToken

# Bật thanh công cụ mô phỏng dành riêng cho môi trường phát triển khi chạy mock
VITE_ENABLE_DEV_TOOLS=true
